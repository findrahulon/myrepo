# RAGnarok Environment Configuration

# PostgreSQL
POSTGRES_DB=ragnarok
POSTGRES_USER=ragnarok
POSTGRES_PASSWORD=ragnarok_secret

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET=ragnarok-documents

# Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin123
KEYCLOAK_REALM=ragnarok

# OpenAI
OPENAI_API_KEY=your-openai-api-key
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_PROJECT=
OPENAI_ORG=
PRIMARY_MODEL=gpt-4o-mini
FALLBACK_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=90
OPENAI_MAX_TOKENS=512
OPENAI_TEMPERATURE=0.2

# Qdrant
COLLECTION_NAME=enterprise_knowledge

# Jira Integration Settings
JIRA_URL=https://your-domain.atlassian.net/
JIRA_AUTH_METHOD=basic
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your-atlassian-api-token
JIRA_SYNC_JQL=project = "RAG"

# Confluence Integration Settings (optional; defaults to Jira settings if shared)
CONFLUENCE_URL=https://your-domain.atlassian.net/wiki
CONFLUENCE_EMAIL=your-email@example.com
CONFLUENCE_API_TOKEN=your-atlassian-api-token
CONFLUENCE_SPACE_KEY=Policies
