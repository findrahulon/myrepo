# RAGnarok Environment Configuration

# Public hostname or IP address of the deployment host.
# Set this to the EC2 public IP / DNS when deploying remotely.
# Defaults to 'localhost' for local development.
PUBLIC_HOST=localhost

# PostgreSQL
POSTGRES_DB=ragnarok
POSTGRES_USER=ragnarok
POSTGRES_PASSWORD=ragnarok_secret

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET=ragnarok-documents

# Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin123
KEYCLOAK_REALM=ragnarok

# Ollama
PRIMARY_MODEL=llama3.1:8b
FALLBACK_MODEL=qwen3:8b

# Qdrant
COLLECTION_NAME=enterprise_knowledge
