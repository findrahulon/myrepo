# RAGnarok Environment Configuration

# IMPORTANT: Public hostname or IP address of the deployment host.
# For EC2/remote: set to the public IP or DNS (e.g., PUBLIC_HOST=3.95.167.24)
# For local dev: leave as localhost
# If not set correctly, Keycloak login will redirect to localhost and fail.
PUBLIC_HOST=localhost

# PostgreSQL
POSTGRES_DB=ragnarok
POSTGRES_USER=ragnarok
POSTGRES_PASSWORD=ragnarok_secret

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET=ragnarok-documents

# Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin123
KEYCLOAK_REALM=ragnarok

# Ollama — phi (2.7B) is recommended for CPU-only instances.
# Use llama3.1:8b only if you have a GPU.
PRIMARY_MODEL=phi
FALLBACK_MODEL=phi

# Qdrant
COLLECTION_NAME=enterprise_knowledge
